# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.env

# HuggingFace 本地缓存（运行期产物，勿提交）
hf_cache/

# 本地运行日志（scripts/run_posttrainbench_local.sh 的 tee 产物）
logs/

# 1. 忽略 workspace 下的所有内容（但保留目录结构，允许进入）
workspace/*
!workspace/.gitkeep

# 2. 放行 _agent_root 目录本身
!workspace/_agent_root/
workspace/_agent_root/*
# 3. 放行 vendored DataFlow 源码副本（已提交进仓库，Apache-2.0，见 dataflow/VENDOR.md）
!workspace/_agent_root/dataflow/
!workspace/_agent_root/dataflow/**
# 3b. 但 vendored 目录内的 Python 编译产物仍忽略（上面的 ** 放行会盖掉顶部规则，需在此重新忽略）
workspace/_agent_root/dataflow/**/__pycache__/
workspace/_agent_root/dataflow/**/*.py[cod]

# 4. 放行 _agent_root 下的 .claude 目录
!workspace/_agent_root/.claude/
# 5. 放行 skills 目录及其所有子内容
!workspace/_agent_root/.claude/skills/
!workspace/_agent_root/.claude/skills/**