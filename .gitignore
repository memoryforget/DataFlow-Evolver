__pycache__/
*.py[cod]
*.egg-info/
build/
.pytest_cache/
.env

# User-provided assets.
data/*
model/*
input/*
logs/
hf_cache/
# Keep runtime-heavy artifacts ignored, but version the small deterministic
# diagnostic manifest used by periodic downstream evaluation. Third-party
# benchmark rows remain external and are regenerated by the tracked preparer.
artifacts/*
!artifacts/downstream_eval/
artifacts/downstream_eval/*
!artifacts/downstream_eval/math_diagnostics_seed42/
artifacts/downstream_eval/math_diagnostics_seed42/*
!artifacts/downstream_eval/math_diagnostics_seed42/manifest.json
scripts/downstream/vendor/qwen25_math/latex2sympy/gen/*.interp
scripts/downstream/vendor/qwen25_math/latex2sympy/gen/*.tokens

# Local experiment records and one-off comparison assets.
archive/
experiments/
docs/experiments/

# Local heterogeneous-math comparison configuration and launcher.
configs/math_markdown_pilot6_compare.yaml
scripts/run_math_markdown_pilot6_compare.sh

# The workspace is the Agent project root. Keep its project skill and vendored
# DataFlow source tracked; ignore runtime state and unrelated root-level output.
workspace/*
!workspace/.claude/
!workspace/.claude/**
!workspace/.agents/
!workspace/.agents/**
!workspace/.opencode/
!workspace/.opencode/**
!workspace/dataflow/
!workspace/dataflow/**
workspace/dataflow/**/__pycache__/
workspace/dataflow/**/*.py[cod]
